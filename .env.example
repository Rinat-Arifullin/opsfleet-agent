# Copy to .env (git-ignored) and fill in. Placeholders only: never commit real values.

# --- Required ---------------------------------------------------------------
# Your own GCP project; BigQuery jobs are billed to it (needs roles/bigquery.jobUser).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Gemini API key from Google AI Studio (not needed with OPSFLEET_LLM_PROVIDER=lmstudio).
GEMINI_API_KEY=your_gemini_api_key_here
# Encrypts the saved conversation state (checkpoints): exactly 16, 24 or 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_hex(16))"
LANGGRAPH_AES_KEY=replace_with_32_random_characters

# --- Optional: Langfuse tracing (off unless all three are set) ----------------
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_HOST=http://localhost:3000

# --- Optional: overrides (defaults shown) -------------------------------------
# OPSFLEET_DATA_DIR=data
# OPSFLEET_MODELS_YAML=config/models.yaml
# OPSFLEET_PROFILES_YAML=config/profiles.yaml
# Dev only: a local model in LM Studio instead of Gemini
# OPSFLEET_LLM_PROVIDER=lmstudio
# OPSFLEET_LLM_BASE_URL=http://127.0.0.1:1234/v1
